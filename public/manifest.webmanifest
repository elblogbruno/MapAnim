{
  "name": "Route Motion Studio",
  "short_name": "MapAnim",
  "description": "Crea animaciones cinemáticas de rutas de viaje en 2D y 3D",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
